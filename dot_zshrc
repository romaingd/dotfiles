# ~/.zshrc — interactive shells only. Environment lives in ~/.zshenv.
[[ -o interactive ]] || return

# ── history ──────────────────────────────────────────────────────────────
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=200000
SAVEHIST=200000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY

# ── options ──────────────────────────────────────────────────────────────
setopt INTERACTIVE_COMMENTS NO_BEEP AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
WORDCHARS=${WORDCHARS//[\/.=-]/}          # ctrl-w / alt-backspace stop at path separators

# ── completion (dump rebuilt at most once a day) ─────────────────────────
fpath=("$XDG_DATA_HOME/zsh/completions" $fpath)
autoload -Uz compinit
typeset -g _zcd="$XDG_CACHE_HOME/zsh/zcompdump"
[[ -d ${_zcd:h} ]] || mkdir -p "${_zcd:h}"
typeset -a _stale=( $_zcd(N.mh+24) )
if [[ -f $_zcd && $#_stale -eq 0 ]]; then compinit -C -d "$_zcd"; else compinit -d "$_zcd"; fi
unset _zcd _stale
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu no            # fzf-tab takes over the menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── keys ─────────────────────────────────────────────────────────────────
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search      # up/down: history search by typed prefix
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[3~'   delete-char

# ── tools (each guarded, so the same file works on machines lacking them) ─
(( $+commands[fzf] ))     && source <(fzf --zsh)          # ctrl-r history, ctrl-t files, alt-c dirs
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
(( $+commands[zoxide] ))  && eval "$(zoxide init zsh)"     # adds z / zi; does NOT replace cd
(( $+commands[mise] ))    && eval "$(mise activate zsh)"
(( $+commands[direnv] ))  && eval "$(direnv hook zsh)"

# ── aliases ──────────────────────────────────────────────────────────────
[[ -r $XDG_CONFIG_HOME/zsh/aliases.zsh ]] && source "$XDG_CONFIG_HOME/zsh/aliases.zsh"

# ── plugins (cloned by chezmoi, see .chezmoiexternal.toml). Order matters:
#    fzf-tab after compinit, syntax highlighting last.
_zplug() { [[ -r $XDG_DATA_HOME/zsh/plugins/$1/$2 ]] && source "$XDG_DATA_HOME/zsh/plugins/$1/$2"; }
_zplug fzf-tab                  fzf-tab.plugin.zsh
_zplug zsh-autosuggestions      zsh-autosuggestions.zsh
_zplug fast-syntax-highlighting fast-syntax-highlighting.plugin.zsh
unfunction _zplug

# ── prompt ───────────────────────────────────────────────────────────────
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ── per-profile and per-machine extras ───────────────────────────────────
[[ -r $XDG_CONFIG_HOME/zsh/work.zsh ]] && source "$XDG_CONFIG_HOME/zsh/work.zsh"   # only deployed on the work profile
[[ -r $HOME/.zshrc.local ]]            && source "$HOME/.zshrc.local"              # untracked, machine-specific
