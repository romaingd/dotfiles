# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
alias s='cd ~/spinergie'
alias c='clear'
alias glu='gl && uv sync --group dev'

alias vpnco='aws-vpn-client connect --profile-name spin-main'
alias vpndis='aws-vpn-client disconnect --profile-name spin-main'

# Spindata usual aliases
alias ll='ls -alF'
alias actpoet='source $(poetry env info --path)/bin/activate'
alias actvenv='source .venv/bin/activate'
alias ds='cd ~/spinergie/spindata && actvenv'
alias sdo='cd ~/spinergie/spindevops && actvenv'
alias sco='cd ~/spinergie/spinconso && actvenv'
alias lsc='cd ~/spinergie/spincrawling && actvenv'
alias app='cd ~/spinergie/spinapp/'
alias glg='glol -10'
alias dkb='docker exec -it spinapp env TERM=xterm-256color script -q -c "cd /app/spinapp && zsh"'
alias sdj='cd ~/spinergie/spinapp/spindjango && actvenv'

# Do not trouble yourself with load_dump's location
alias load_dump='/home/romain/spinergie/spindevops/.venv/bin/python /home/romain/spinergie/spindevops/spindevops/scripts/load_dump.py'

# To debug python script in vscode
alias debugp='python -m debugpy --listen 5678 --wait-for-client'

# Command to launch qc for the analyst. To be followed with the qc code (file name without .py)
alias qc='$(cd ~/spinergie/spindata && poetry env use 3.11 --quiet && poetry env info --path)/bin/python ~/spinergie/spindata/spindata/Cross_app/notifications/launch_notif.py pipelay -q -d -c'

PATH="$HOME/.local/bin:$PATH"
source /home/romain/spinergie/infra/dev_tools/aws_helpers.sh
export AWS_PROFILE=spin-main
source /home/romain/spinergie/infra/dev_tools/vscode_deactivate

export POETRY_HTTP_BASIC_CODEARTIFACT_USERNAME=aws
export POETRY_HTTP_BASIC_CODEARTIFACT_PASSWORD=$(cat ~/.aws/codeartifact)

export UV_INDEX_CODEARTIFACT_USERNAME=aws
export UV_INDEX_CODEARTIFACT_PASSWORD=$(cat ~/.aws/codeartifact)

# Set up fzf key bindings and fuzzy completion
source /usr/share/doc/fzf/examples/key-bindings.zsh

autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /home/romain/.local/bin/.tfenv/versions/1.12.2/terraform terraform

complete -o nospace -C /home/romain/.local/bin/.tfenv/versions/1.9.7/terraform terraform

