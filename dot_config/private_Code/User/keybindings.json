// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+e",
    "command": "workbench.action.quickTextSearch"
  },
  {
    "key": "ctrl+'",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "alt+d",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+v",
    "command": "pr.markFileAsViewed"
  },
  {
    "key": "alt+f3",
    "command": "python.execInTerminal-icon"
  },
  {
    "key": "ctrl+\\",
    "command": "-workbench.action.splitEditor"
  },
  {
    "key": "ctrl+alt+\\",
    "command": "-jupyter.selectCellContents",
    "when": "editorTextFocus && jupyter.hascodecells && !jupyter.webExtension && !notebookEditorFocused"
  },
  {
    "key": "ctrl+alt+\\",
    "command": "editor.action.jumpToBracket",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+\\",
    "command": "-editor.action.jumpToBracket",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+\\",
    "command": "workbench.action.moveEditorToRightGroup"
  },
  {
    "key": "ctrl+shift+\\",
    "command": "workbench.action.moveEditorToLeftGroup"
  },
  {
    "key": "ctrl+k ctrl+k",
    "command": "deleteAllRight"
  },
  {
    "key": "ctrl+k ctrl+c",
    "command": "editor.action.addCommentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+k ctrl+c",
    "command": "-editor.action.addCommentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+]",
    "command": "workbench.action.focusCommentsPanel"
  },
  {
    "key": "ctrl+alt+/",
    "command": "editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+k ctrl+l",
    "command": "-editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+escape",
    "command": "-workbench.action.chat.cancel"
  },
  {
    "key": "ctrl+k ctrl+l",
    "command": "workbench.action.chat.newChat",
    "when": "chatEditingParticipantRegistered && chatIsEnabled && inChat"
  },
  {
    "key": "ctrl+l",
    "command": "-workbench.action.chat.newChat",
    "when": "chatEditingParticipantRegistered && chatIsEnabled && inChat"
  },
  {
    "key": "ctrl+k shift+l",
    "command": "editor.toggleFoldRecursively",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+k ctrl+shift+l",
    "command": "-editor.toggleFoldRecursively",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+k ctrl+shift+l",
    "command": "continue.focusContinueInputWithoutClear"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-continue.focusContinueInputWithoutClear"
  },
  {
    "key": "ctrl+k ctrl+l",
    "command": "continue.focusContinueInput"
  },
  {
    "key": "ctrl+l",
    "command": "-continue.focusContinueInput"
  },
  {
    "key": "ctrl+shift+r",
    "command": "-continue.debugTerminal"
  },
  {
    "key": "ctrl+]",
    "command": "prStatus:github.focus"
  },
  {
    "key": "ctrl+alt+p",
    "command": "editor.gotoParentFold"
  },
  {
    "key": "alt+;",
    "command": "claude-vscode.insertAtMention",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+k",
    "command": "-claude-vscode.insertAtMention",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+;",
    "command": "claude-code.insertAtMentioned",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+k",
    "command": "-claude-code.insertAtMentioned",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+escape",
    "command": "-claude-vscode.terminal.open.keyboard",
    "when": "config.claudeCode.useTerminal"
  },
  {
    "key": "ctrl+shift+alt+b",
    "command": "workbench.action.toggleMaximizedAuxiliaryBar"
  },
  {
    "key": "ctrl+shift+alt+up",
    "command": "-editor.action.copyLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+meta+up",
    "command": "gitlens.copyDeepLinkToLines"
  },
  {
    "key": "ctrl+alt+c",
    "command": "-copyFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+k ctrl+alt+c",
    "command": "-copyFilePath",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+alt+c",
    "command": "copyRelativeFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+shift+alt+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+alt+c",
    "command": "copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+k ctrl+shift+alt+c",
    "command": "-copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+o",
    "command": "workbench.action.files.openFile",
    "when": "!claude-vscode.sideBarActive"
  },
  {
    "key": "ctrl+o",
    "command": "-workbench.action.files.openFile",
    "when": "true"
  },
  {
    "key": "ctrl+alt+s",
    "command": "diffEditor.switchSide",
    "when": "isInDiffEditor"
  },
  {
    "key": "ctrl+alt+enter",
    "command": "lean4.toggleInfoview",
    "when": "lean4.isLeanFeatureSetActive"
  },
  {
    "key": "ctrl+shift+enter",
    "command": "-lean4.toggleInfoview",
    "when": "lean4.isLeanFeatureSetActive"
  }
]
