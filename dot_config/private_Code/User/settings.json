{
  // ============================================================
  // 1. AI / TELEMETRY
  // ============================================================
  // Built-in Copilot chat/inline suggestions off
  "chat.disableAIFeatures": true,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  // Manual updates = no surprise changes; you still get "update available" notices.
  "extensions.autoUpdate": "off",

  // ============================================================
  // 2. APPEARANCE / WORKBENCH
  // ============================================================
  "workbench.colorTheme": "One Dark Pro Darker",
  "window.customMenuBarAltFocus": false,
  "window.menuBarVisibility": "compact",
  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "workbench.externalBrowser": "firefox",

  // ============================================================
  // 3. EDITOR (power: no constant repaints)
  // ============================================================
  "editor.fontFamily": "'Fira Code', monospace",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "editor.inlayHints.enabled": "on", // replaces python.analysis.inlayHints.functionReturnTypes

  // ============================================================
  // 4. FILES / SEARCH / WATCHERS
  // ============================================================
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "explorer.confirmDelete": false,
  "files.exclude": {
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/.git": true,
    "**/.venv/**": true,
    "**/.venv_container/**": true,
    "**/node_modules": true,
    "**/target/**": true,
    "**/.lake/**": true
  },
  // .lake deliberately NOT excluded from search: lets you grep Mathlib from the editor.
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/.venv_container": true,
    "**/target": true
  },
  "search.maxResults": 1000,
  "search.quickAccess.preserveInput": true,
  "search.searchOnTypeDebouncePeriod": 400,

  // ============================================================
  // 4b. DIFF
  // ============================================================
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": true,

  // ============================================================
  // 5. TERMINAL (tmux/Alacritty is the real terminal; this is the side one)
  // ============================================================
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.external.linuxExec": "alacritty",

  // ============================================================
  // 6. GIT (built-in)
  // ============================================================
  // autofetch = periodic network + wakeups; fine, but first thing to turn off on battery.
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.blame.editorDecoration.enabled": false,
  "git.blame.statusBarItem.enabled": true,

  // ============================================================
  // 7. PYTHON
  // ============================================================
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // ============================================================
  // 8. RUST
  // ============================================================
  "rust-analyzer.check.command": "clippy",
  // Own target dir for rust-analyzer so checks don't fight `cargo build` for the lock.
  "rust-analyzer.cargo.targetDir": true,

  // ============================================================
  // 9. LANGUAGE-SPECIFIC FORMATTERS
  // ============================================================
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
  },

  // ============================================================
  // 10. CLAUDE CODE
  // ============================================================

  // ============================================================
  // 11. EXTENSION SETTINGS
  // ============================================================
  "rewrap.wrappingColumn": 100,
}